{
  "name": "zorr-mob-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0 <25" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "build": "node scripts/build.mjs",
    "dev": "wrangler pages dev dist --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:python": "uv run python -m unittest discover -s tests -p 'test_*.py' -v",
    "deploy": "wrangler pages deploy dist --project-name zorr-mob-notifier"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "wrangler": "4.151.1"
  }
}
