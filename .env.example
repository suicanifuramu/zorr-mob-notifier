# Copy this file to .env. Settings are read only from .env; real environment
# variables are ignored.
#
# User token (not a bot token). Never commit it.
DISCORD_TOKEN=

# Required for live mode. Numeric Discord IDs of the guild and channel to read.
GUILD_ID=
CHANNEL_ID=

# Required for --serve and --demo. Generate a random value, for example:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same value as BOT_API_TOKEN in .dev.vars or the Pages environment.
API_TOKEN=

# Bind locally behind a reverse proxy.
BOT_HOST=127.0.0.1
BOT_PORT=8090
DATABASE_PATH=var/spawns.sqlite3
